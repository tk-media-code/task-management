# このファイルを terraform.tfvars にコピーして、実際の値を記入する。
# terraform.tfvars は .gitignore 済みでコミットされない。

# SSHを許可する送信元。自分のグローバルIPに /32 を付ける。
# 確認方法: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.1/32"

# RDSのマスターパスワード（db_password）はここに書かない。
# 1Password から環境変数 TF_VAR_db_password で渡す（参照の雛形は infra/terraform.op）。
# tfvars に書くと平文のファイルが手元に残るため。
# （stateにはどの渡し方でも平文で入るので、tfstate と .backup は秘密として扱う）
# 既に db_password の行があれば消す。tfvars は環境変数より優先され、残ると TF_VAR_ が無視される。

# HTTPを許可する送信元。既定は全開放。
# ベーシック認証もHTTPSも実装していないため、人に見せる必要がない間は
# 自分のIPだけに絞っておくとよい。
# http_allowed_cidrs = ["203.0.113.1/32"]
